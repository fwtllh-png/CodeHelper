{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper production evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "family",
    "owner",
    "risk",
    "driver",
    "provider_mode",
    "workspace",
    "fixture_id",
    "expected_facts",
    "turns",
    "faults",
    "oracles",
    "required_evidence",
    "required_mutations",
    "cleanup_contract",
    "run_plan",
    "budgets",
    "requirements",
    "execution",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "$ref": "#/$defs/id"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "driver": {
      "enum": [
        "command",
        "acp",
        "vscode-electron",
        "tui",
        "worker"
      ]
    },
    "provider_mode": {
      "enum": [
        "fixture",
        "recorded",
        "live",
        "none"
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "$ref": "#/$defs/id"
    },
    "expected_facts": {
      "$ref": "#/$defs/id_list"
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_file"
        ],
        "properties": {
          "prompt_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "action"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "oracles": {
      "$ref": "#/$defs/id_list"
    },
    "required_evidence": {
      "$ref": "#/$defs/id_list"
    },
    "required_mutations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "cleanup_contract": {
      "$ref": "#/$defs/id"
    },
    "run_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "collect_all_group"],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "collect_all_group": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "working_directory"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "risk": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "id_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "platforms",
        "capabilities"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "max_attempts",
        "max_output_bytes"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
