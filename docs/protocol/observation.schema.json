{
  "$id": "https://codehelper.dev/schemas/observation-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causality": {
      "additionalProperties": false,
      "properties": {
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "enum": [
                  "caused_by",
                  "produced",
                  "observed_by",
                  "delivered_to",
                  "retried_from",
                  "recovered_from",
                  "projected_as",
                  "verified_by",
                  "committed_with"
                ],
                "type": "string"
              },
              "target": {
                "pattern": "^obs_[0-9a-f]{32}$",
                "type": "string"
              }
            },
            "required": [
              "relation",
              "target"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "parent_observation_id": {
          "pattern": "^obs_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "id": {
      "pattern": "^obs_[0-9a-f]{32}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 256,
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "attempt_id": {
          "maxLength": 256,
          "type": "string"
        },
        "call_id": {
          "maxLength": 256,
          "type": "string"
        },
        "effect_id": {
          "maxLength": 256,
          "type": "string"
        },
        "event_cursor": {
          "minimum": 1,
          "type": "integer"
        },
        "event_id": {
          "maxLength": 256,
          "type": "string"
        },
        "extension_operation_id": {
          "maxLength": 256,
          "type": "string"
        },
        "fact_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "node_id": {
          "maxLength": 256,
          "type": "string"
        },
        "operation_id": {
          "maxLength": 256,
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "type": "string"
        },
        "runtime_id": {
          "maxLength": 256,
          "type": "string"
        },
        "sample_id": {
          "maxLength": 256,
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "type": "string"
        },
        "thread_id": {
          "maxLength": 256,
          "type": "string"
        },
        "turn_id": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "required": [
        "runtime_id"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "agent.closed",
        "agent.message.sent",
        "agent.result.delivered",
        "agent.spawned",
        "agent.task.delivered",
        "approval.requested",
        "approval.resolved",
        "authority.profile.bound",
        "context.compacted",
        "context.projected",
        "context.visibility.committed",
        "effect.finished",
        "effect.requested",
        "effect.requeued",
        "effect.result.retained",
        "effect.started",
        "egress.decided",
        "egress.requested",
        "extension.operation.finished",
        "extension.operation.started",
        "extension.subscriber.dropped",
        "guard.decision",
        "journal.committed",
        "journal.opened",
        "journal.rolled_back",
        "journal.suspended",
        "model.first_output",
        "model.request.failed",
        "model.request.prepared",
        "model.request.sent",
        "model.response.completed",
        "model.retry.scheduled",
        "mutation.observed",
        "operation.accepted",
        "operation.rejected",
        "process.exited",
        "process.started",
        "process.teardown.completed",
        "runtime.crashed",
        "runtime.degraded",
        "runtime.ready",
        "runtime.started",
        "runtime.stopped",
        "runtime.stopping",
        "sandbox.attempt.started",
        "sandbox.denied",
        "tool.admitted",
        "tool.finished",
        "tool.proposed",
        "tool.result.model_visible",
        "tool.result.produced",
        "tool.runtime.output",
        "tool.started",
        "turn.recovered",
        "turn.started",
        "turn.terminal.committed",
        "turn.terminal.prepared",
        "turn.transition.committed",
        "verification.finished",
        "verification.started",
        "workflow.node.transitioned"
      ],
      "type": "string"
    },
    "monotonic_ns": {
      "minimum": 0,
      "type": "integer"
    },
    "observed_sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "data_class": {
          "enum": [
            "public_metadata",
            "operational",
            "workspace_content",
            "conversation_content",
            "credential",
            "restricted"
          ],
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "encoding": {
          "maxLength": 256,
          "type": "string"
        },
        "media_type": {
          "maxLength": 256,
          "type": "string"
        },
        "original_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "redaction": {
          "enum": [
            "not_required",
            "applied",
            "unavailable"
          ],
          "type": "string"
        },
        "stored_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "digest",
        "media_type",
        "original_bytes",
        "stored_bytes",
        "data_class",
        "redaction"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "public_metadata",
            "operational",
            "workspace_content",
            "conversation_content",
            "credential",
            "restricted"
          ],
          "type": "string"
        },
        "redaction": {
          "enum": [
            "not_required",
            "applied",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "class",
        "redaction"
      ],
      "type": "object"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "summary": {},
    "trace": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "span_id": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "trace_flags": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "trace_state": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "observed_sequence",
    "sequence",
    "recorded_at",
    "identity",
    "policy"
  ],
  "title": "CodeHelper Observation Envelope",
  "type": "object"
}
