{
  "schema_version": 1,
  "requirement_id": "TASK-ORCHESTRATION-OR2",
  "status": "accepted",
  "captured_on": "2026-08-16",
  "baseline_commit": "18e1ce8f052794d18f6cc19d16db44b904f6e70f",
  "aggregate": {
    "name": "WorkGraph",
    "entities": [
      "Run",
      "Node",
      "Attempt",
      "Effect"
    ],
    "single_active_attempt_per_node": true,
    "terminal_run_requires_terminal_nodes": true,
    "authority_digest_validation": "lowercase SHA-256",
    "revision_compare_and_swap": true
  },
  "kernel": {
    "pure_reducer": true,
    "commands": [
      "submit_run",
      "cancel_run",
      "resume_run",
      "retry_node",
      "skip_node",
      "claim_node",
      "bind_execution",
      "settle_execution"
    ],
    "facts": [
      "run_submitted",
      "run_status",
      "node_declared",
      "node_status",
      "attempt_created",
      "attempt_status",
      "execution_bound",
      "effect_queued"
    ],
    "effects": [
      "dispatch_execution",
      "cancel_execution",
      "publish_run_terminal"
    ]
  },
  "persistence": {
    "tables": [
      "work_runs",
      "work_commands",
      "work_facts",
      "work_outbox"
    ],
    "atomic_transaction": [
      "aggregate snapshot",
      "ordered facts",
      "effect outbox",
      "command receipt"
    ],
    "command_digest_deduplication": true,
    "stable_host_event_identity": "SHA-256 of operation_id and fact event index",
    "fact_replay_rebuild": true,
    "snapshot_drift_detection": true,
    "terminal_outbox_fault_injection": true,
    "concurrent_revision_single_winner": true
  },
  "runtime_protocol": {
    "public_operations": [
      "run.submit",
      "run.cancel",
      "run.resume",
      "node.retry",
      "node.skip"
    ],
    "operation_kinds": 13,
    "event_kinds": 48,
    "hierarchical_event_references": {
      "run": [
        "run_id"
      ],
      "node": [
        "run_id",
        "node_id"
      ],
      "attempt": [
        "run_id",
        "node_id",
        "attempt_id"
      ],
      "execution": [
        "run_id",
        "node_id",
        "attempt_id",
        "effect_id"
      ]
    },
    "vscode_generated_contract": true,
    "acp_advertisement_generated_from_protocol": true
  },
  "recovery": {
    "accepted_operation_replay": true,
    "duplicate_command_returns_original_receipt": true,
    "partial_host_event_replay_is_idempotent": true,
    "intermediate_running_snapshot_rebuild": true,
    "terminal_commit_and_outbox_atomic": true
  },
  "scope_boundary": {
    "task_repository_migrated": false,
    "worker_migrated": false,
    "workflow_scheduler_migrated": false,
    "reason": "OR2 establishes the authority and durable contract; OR3 and OR4 migrate existing producers and schedulers without dual writes."
  },
  "gates": [
    "make task-orchestration-or2",
    "go test -race -p 1 ./internal/orchestration/model ./internal/orchestration/kernel ./internal/orchestration/store ./internal/runtime/protocol ./internal/runtime/app",
    "go test ./internal/orchestration/kernel -run '^$' -fuzz '^FuzzReducerPreservesInvariants$' -fuzztime=5s",
    "make architecture-ratchet",
    "make vscode-protocol-check",
    "make docs-check",
    "make book-check",
    "git diff --check"
  ]
}
