{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper production evaluation Foundation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "contracts",
    "oracle_catalog",
    "mutation_catalog",
    "core_pack",
    "impact_policy",
    "implementation_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "production-evaluation-foundation"
    },
    "status": {
      "const": "implementation"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "owner",
          "producer",
          "consumer",
          "absence_status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "$ref": "#/$defs/id"
          },
          "producer": {
            "$ref": "#/$defs/id"
          },
          "consumer": {
            "$ref": "#/$defs/id"
          },
          "absence_status": {
            "const": "invalid"
          }
        }
      }
    },
    "oracle_catalog": {
      "type": "string",
      "minLength": 1
    },
    "mutation_catalog": {
      "type": "string",
      "minLength": 1
    },
    "core_pack": {
      "type": "string",
      "minLength": 1
    },
    "impact_policy": {
      "type": "string",
      "minLength": 1
    },
    "implementation_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    }
  }
}
