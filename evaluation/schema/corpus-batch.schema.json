{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper qualified corpus batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_digest",
    "review_digest",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "review_digest": {
      "$ref": "#/$defs/digest"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
