{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fwtllh-png/QCode/docs/book/schema/chapter.schema.json",
  "title": "QCode Knowledge Book Chapter Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "audience",
    "prerequisites",
    "code_paths",
    "test_paths",
    "source_of_truth",
    "status",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["learner", "user", "contributor", "operator", "agent"]
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "code_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["draft", "verified"]
    },
    "last_verified": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "last_verified": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
