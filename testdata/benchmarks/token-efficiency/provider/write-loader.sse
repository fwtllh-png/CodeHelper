data: {"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_write_loader","function":{"name":"file_write","arguments":"{\"path\":\"config/loader.go\",\"content\":\"package config\\n\\nimport (\\n\\t\\\"bufio\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strings\\\"\\n)\\n\\n// Load returns entries declared by path and its nested includes.\\nfunc Load(path string) ([]string, error) {\\n\\tseen := make(map[string]bool)\\n\\tactive := make(map[string]int)\\n\\tvar stack, entries []string\\n\\tvar walk func(string) error\\n\\twalk = func(path string) error {\\n\\t\\tabsolute, err := filepath.Abs(path)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tpath = filepath.Clean(absolute)\\n\\t\\tif start, ok := active[path]; ok {\\n\\t\\t\\tcycle := append(append([]string{}, stack[start:]...), path)\\n\\t\\t\\treturn fmt.Errorf(\\\"include cycle: %s\\\", strings.Join(cycle, \\\" -> \\\"))\\n\\t\\t}\\n\\t\\tfile, err := os.Open(path)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tdefer file.Close()\\n\\t\\tactive[path] = len(stack)\\n\\t\\tstack = append(stack, path)\\n\\t\\tdefer func() {\\n\\t\\t\\tdelete(active, path)\\n\\t\\t\\tstack = stack[:len(stack)-1]\\n\\t\\t}()\\n\\t\\tscanner := bufio.NewScanner(file)\\n\\t\\tfor scanner.Scan() {\\n\\t\\t\\tfields := strings.Fields(scanner.Text())\\n\\t\\t\\tif len(fields) < 2 {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\tswitch fields[0] {\\n\\t\\t\\tcase \\\"include\\\":\\n\\t\\t\\t\\tif err := walk(filepath.Join(filepath.Dir(path), fields[1])); err != nil {\\n\\t\\t\\t\\t\\treturn err\\n\\t\\t\\t\\t}\\n\\t\\t\\tcase \\\"entry\\\":\\n\\t\\t\\t\\tentry := strings.Join(fields[1:], \\\" \\\" )\\n\\t\\t\\t\\tif !seen[entry] {\\n\\t\\t\\t\\t\\tseen[entry] = true\\n\\t\\t\\t\\t\\tentries = append(entries, entry)\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn scanner.Err()\\n\\t}\\n\\tif err := walk(path); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn entries, nil\\n}\\n\"}"}}]},"finish_reason":"tool_calls"}]}

