{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper H4 Canary Admission Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "source_digest",
    "lock_identity",
    "foundation_digest",
    "runtime_digest",
    "vsix_digest",
    "h3_qualification_id",
    "h3_release_digest",
    "package_digest",
    "required_lanes",
    "scope",
    "public_release",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_id": {"$ref": "#/$defs/id"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "lock_identity": {"$ref": "#/$defs/digest"},
    "foundation_digest": {"$ref": "#/$defs/digest"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "vsix_digest": {"$ref": "#/$defs/digest"},
    "h3_qualification_id": {"$ref": "#/$defs/id"},
    "h3_release_digest": {"$ref": "#/$defs/digest"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "required_lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_digest"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "status": {"const": "passed"},
          "evidence_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "scope": {"const": "controlled_local_inventory"},
    "public_release": {"const": false},
    "decision": {"enum": ["admit", "deny"]}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
