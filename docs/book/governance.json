{
  "schema_version": 1,
  "owners": [
    {
      "id": "maintainers",
      "responsibility": "Final review for runtime contracts, security claims, and book governance"
    }
  ],
  "freshness": {
    "verified_max_age_days": 180,
    "warning_age_days": 150
  },
  "domains": [
    {
      "id": "agent-engineering",
      "owner": "maintainers",
      "chapter_patterns": [
        "agent-*"
      ],
      "source_patterns": [
        "README*.md",
        "docs/*/overview.md"
      ]
    },
    {
      "id": "codehelper-overview",
      "owner": "maintainers",
      "chapter_patterns": [
        "overview-*"
      ],
      "source_patterns": [
        "AGENTS.md",
        "docs/*/architecture.md",
        "internal/architecture_test.go"
      ]
    },
    {
      "id": "runtime-kernel",
      "owner": "maintainers",
      "chapter_patterns": [
        "runtime-*"
      ],
      "source_patterns": [
        "internal/runtime/**",
        "docs/protocol/**"
      ]
    },
    {
      "id": "model-provider",
      "owner": "maintainers",
      "chapter_patterns": [
        "model-*"
      ],
      "source_patterns": [
        "internal/adapter/model/**",
        "internal/adapter/provider/**"
      ]
    },
    {
      "id": "context-engineering",
      "owner": "maintainers",
      "chapter_patterns": [
        "context-*"
      ],
      "source_patterns": [
        "internal/adapter/memory/**",
        "internal/adapter/lsp/**",
        "internal/persist/repoindex/**",
        "internal/platform/symbols/**",
        "internal/runtime/agent/context/**",
        "internal/runtime/agent/prompt/**",
        "internal/runtime/agent/context/**"
      ]
    },
    {
      "id": "tools-execution",
      "owner": "maintainers",
      "chapter_patterns": [
        "tool-*"
      ],
      "source_patterns": [
        "internal/adapter/tool/**"
      ]
    },
    {
      "id": "security-governance",
      "owner": "maintainers",
      "chapter_patterns": [
        "security-*"
      ],
      "source_patterns": [
        "internal/security/**",
        "internal/platform/process/**",
        "SECURITY*.md"
      ]
    },
    {
      "id": "state-observability",
      "owner": "maintainers",
      "chapter_patterns": [
        "state-*"
      ],
      "source_patterns": [
        "internal/observability/**",
        "internal/persist/**"
      ]
    },
    {
      "id": "task-orchestration",
      "owner": "maintainers",
      "chapter_patterns": [
        "task-*"
      ],
      "source_patterns": [
        "internal/orchestration/**"
      ]
    },
    {
      "id": "hosts-protocols",
      "owner": "maintainers",
      "chapter_patterns": [
        "host-*"
      ],
      "source_patterns": [
        "internal/host/**",
        "web/**",
        "testdata/contracts/host-journey-contract.json"
      ]
    },
    {
      "id": "extension-ecosystem",
      "owner": "maintainers",
      "chapter_patterns": [
        "extension-*"
      ],
      "source_patterns": [
        "internal/adapter/extension/**",
        "internal/adapter/hooks/**",
        "internal/adapter/mcp/**",
        "internal/adapter/skill/**",
        "internal/runtime/extension/**",
        "internal/runtime/app/extension/**",
        "internal/persist/extensioncontrol/**",
        "internal/persist/extensionplan/**"
      ]
    },
    {
      "id": "engineering-practice",
      "owner": "maintainers",
      "chapter_patterns": [
        "practice-*"
      ],
      "source_patterns": [
        ".github/**",
        "Makefile",
        "scripts/**",
        "web/**",
        "testdata/contracts/benchmark-v2.json",
        "testdata/contracts/hotspot-baseline.json"
      ]
    },
    {
      "id": "hands-on-labs",
      "owner": "maintainers",
      "chapter_patterns": [
        "lab-*"
      ],
      "source_patterns": [
        "testdata/**"
      ]
    }
  ],
  "release_facts": [
    {
      "id": "documentation-contract",
      "command": [
        "make",
        "docs-check"
      ]
    },
    {
      "id": "book-contract",
      "command": [
        "make",
        "book-check"
      ]
    },
    {
      "id": "runtime-help",
      "command": [
        "make",
        "smoke"
      ]
    },
    {
      "id": "protocol-schema",
      "command": [
        "go",
        "test",
        "./internal/runtime/protocol",
        "-run",
        "TestTheCommittedSchemaMatchesThisBuild"
      ]
    },
    {
      "id": "web-feature-parity",
      "command": [
        "make",
        "web-parity-check"
      ]
    },
    {
      "id": "repository-test-topology",
      "command": [
        "go",
        "test",
        "./internal/observability/verify"
      ]
    },
    {
      "id": "benchmark-journeys",
      "command": [
        "make",
        "benchmark-v2"
      ]
    },
    {
      "id": "host-journey",
      "command": [
        "make",
        "host-journey-contract"
      ]
    },
    {
      "id": "web-experience-contract",
      "command": [
        "make",
        "web-experience-check"
      ]
    },
    {
      "id": "web-release-candidate",
      "command": [
        "make",
        "web-check",
        "web-test",
        "web-build"
      ]
    }
  ],
  "screenshots": [],
  "external_link_exclusions": [
    "https://github.com/fwtllh-png/CodeHelper/actions/workflows/ci.yml/badge.svg",
    "https://github.com/fwtllh-png/CodeHelper/security/advisories/new"
  ]
}
