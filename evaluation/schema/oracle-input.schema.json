{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper Multi-Oracle semantic fact input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "run_partition",
    "evidence",
    "runtime",
    "effects_available",
    "expected_effect_count",
    "effects",
    "workspace",
    "verification",
    "persistence",
    "host",
    "security",
    "resources",
    "task_quality"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "scenario_id": {
      "$ref": "#/$defs/id"
    },
    "run_partition": {
      "$ref": "#/$defs/digest"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "effects_available": {
      "type": "boolean"
    },
    "expected_effect_count": {
      "$ref": "#/$defs/nonnegative"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "persistence": {
      "$ref": "#/$defs/persistence"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "task_quality": {
      "$ref": "#/$defs/task_quality"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producer", "digest", "run_partition"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "producer": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "run_partition": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runtime_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "turn",
        "operation"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "turn": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "effect": {
          "$ref": "#/$defs/id"
        },
        "receipt_hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "runtime_terminal",
        "host_terminal",
        "duplicate_items",
        "missing_items"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "runtime_terminal": {
          "type": "string"
        },
        "host_terminal": {
          "type": "string"
        },
        "duplicate_items": {
          "$ref": "#/$defs/nonnegative"
        },
        "missing_items": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "phase",
        "events",
        "mailbox_count",
        "mailbox_capacity",
        "budget_used",
        "budget_limit",
        "projection"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "phase": {
          "enum": ["running", "parked", "terminal"]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/runtime_event"
          }
        },
        "mailbox_count": {
          "$ref": "#/$defs/nonnegative"
        },
        "mailbox_capacity": {
          "$ref": "#/$defs/nonnegative"
        },
        "budget_used": {
          "$ref": "#/$defs/nonnegative"
        },
        "budget_limit": {
          "$ref": "#/$defs/nonnegative"
        },
        "park_owner": {
          "type": "string"
        },
        "park_deadline": {
          "type": "string"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "consequential",
        "claims",
        "executions",
        "results",
        "guarded",
        "approval_required",
        "approval_bound"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "consequential": {
          "type": "boolean"
        },
        "claims": {
          "$ref": "#/$defs/nonnegative"
        },
        "executions": {
          "$ref": "#/$defs/nonnegative"
        },
        "results": {
          "$ref": "#/$defs/nonnegative"
        },
        "guarded": {
          "type": "boolean"
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_bound": {
          "type": "boolean"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "before_digest",
        "after_digest",
        "changed_paths",
        "allowed_paths",
        "preexisting_dirty",
        "preserved_dirty",
        "escaped_root"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "before_digest": {
          "$ref": "#/$defs/digest"
        },
        "after_digest": {
          "$ref": "#/$defs/digest"
        },
        "changed_paths": {
          "$ref": "#/$defs/path_list"
        },
        "allowed_paths": {
          "$ref": "#/$defs/path_list"
        },
        "preexisting_dirty": {
          "$ref": "#/$defs/path_list"
        },
        "preserved_dirty": {
          "$ref": "#/$defs/path_list"
        },
        "escaped_root": {
          "type": "boolean"
        }
      }
    },
    "path_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "commands"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "exit_code",
              "timed_out",
              "mandatory"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unavailable",
                  "not_evaluated",
                  "invalid"
                ]
              },
              "exit_code": {
                "type": ["integer", "null"]
              },
              "timed_out": {
                "type": "boolean"
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "event_digest",
        "replay_digest",
        "snapshot_digest",
        "rebuilt_digest",
        "terminal_digest",
        "receipt_terminal_digest",
        "outbox_publications"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        },
        "replay_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "rebuilt_digest": {
          "$ref": "#/$defs/digest"
        },
        "terminal_digest": {
          "$ref": "#/$defs/digest"
        },
        "receipt_terminal_digest": {
          "$ref": "#/$defs/digest"
        },
        "outbox_publications": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "secret_leaks",
        "unauthorized_egress",
        "sandbox_required",
        "sandbox_available",
        "unsafe_links",
        "permission_bypass"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "secret_leaks": {
          "$ref": "#/$defs/nonnegative"
        },
        "unauthorized_egress": {
          "$ref": "#/$defs/nonnegative"
        },
        "sandbox_required": {
          "type": "boolean"
        },
        "sandbox_available": {
          "type": "boolean"
        },
        "unsafe_links": {
          "$ref": "#/$defs/nonnegative"
        },
        "permission_bypass": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "runtime_terminal",
        "visible_terminal",
        "duplicate_items",
        "missing_items",
        "cursor_committed",
        "continued"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "runtime_terminal": {
          "type": "string"
        },
        "visible_terminal": {
          "type": "string"
        },
        "duplicate_items": {
          "$ref": "#/$defs/nonnegative"
        },
        "missing_items": {
          "$ref": "#/$defs/nonnegative"
        },
        "cursor_committed": {
          "type": "boolean"
        },
        "continued": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "processes_before",
        "processes_after",
        "goroutines_before",
        "goroutines_after",
        "goroutine_tolerance",
        "fds_before",
        "fds_after",
        "fd_tolerance",
        "subscribers_before",
        "subscribers_after",
        "temporary_paths_remaining",
        "queue_peak",
        "queue_capacity",
        "input_bytes",
        "persisted_bytes",
        "max_amplification_milli"
        ,"process_ids_before"
        ,"process_ids_after"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "processes_before": {
          "$ref": "#/$defs/nonnegative"
        },
        "processes_after": {
          "$ref": "#/$defs/nonnegative"
        },
        "goroutines_before": {
          "$ref": "#/$defs/nonnegative"
        },
        "goroutines_after": {
          "$ref": "#/$defs/nonnegative"
        },
        "goroutine_tolerance": {
          "$ref": "#/$defs/nonnegative"
        },
        "fds_before": {
          "$ref": "#/$defs/nonnegative"
        },
        "fds_after": {
          "$ref": "#/$defs/nonnegative"
        },
        "fd_tolerance": {
          "$ref": "#/$defs/nonnegative"
        },
        "subscribers_before": {
          "$ref": "#/$defs/nonnegative"
        },
        "subscribers_after": {
          "$ref": "#/$defs/nonnegative"
        },
        "temporary_paths_remaining": {
          "$ref": "#/$defs/nonnegative"
        },
        "queue_peak": {
          "$ref": "#/$defs/nonnegative"
        },
        "queue_capacity": {
          "$ref": "#/$defs/nonnegative"
        },
        "input_bytes": {
          "$ref": "#/$defs/nonnegative"
        },
        "persisted_bytes": {
          "$ref": "#/$defs/nonnegative"
        },
        "max_amplification_milli": {
          "$ref": "#/$defs/nonnegative"
        },
        "process_ids_before": {
          "$ref": "#/$defs/id_list"
        },
        "process_ids_after": {
          "$ref": "#/$defs/id_list"
        }
      }
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "task_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_available",
        "deterministic",
        "assertions",
        "passed"
      ],
      "properties": {
        "evidence_available": {
          "type": "boolean"
        },
        "deterministic": {
          "type": "boolean"
        },
        "assertions": {
          "$ref": "#/$defs/nonnegative"
        },
        "passed": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    }
  }
}
