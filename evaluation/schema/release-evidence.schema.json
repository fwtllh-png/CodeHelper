{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper production evaluation release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "source_digest",
    "lock_identity",
    "foundation_digest",
    "runtime_digest",
    "vsix_digest",
    "host_digest",
    "provider_digest",
    "model_digest",
    "config_digest",
    "required_lanes",
    "package",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "qualification_id": {
      "$ref": "#/$defs/id"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "lock_identity": {
      "$ref": "#/$defs/digest"
    },
    "foundation_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_digest": {
      "$ref": "#/$defs/digest"
    },
    "vsix_digest": {
      "$ref": "#/$defs/digest"
    },
    "host_digest": {
      "$ref": "#/$defs/digest"
    },
    "provider_digest": {
      "$ref": "#/$defs/digest"
    },
    "model_digest": {
      "$ref": "#/$defs/digest"
    },
    "config_digest": {
      "$ref": "#/$defs/digest"
    },
    "required_lanes": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_digest"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "const": "passed"
          },
          "evidence_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "checksums_digest",
        "sbom_digest",
        "targets"
      ],
      "properties": {
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "checksums_digest": {"$ref": "#/$defs/digest"},
        "sbom_digest": {"$ref": "#/$defs/digest"},
        "targets": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"
          }
        }
      }
    },
    "decision": {
      "enum": ["admit", "deny"]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
