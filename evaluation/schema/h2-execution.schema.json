{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper H2 Live Model Execution Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "model", "protocol", "policy", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"$ref": "#/$defs/id"},
    "model": {"$ref": "#/$defs/id"},
    "protocol": {"enum": ["openai_chat", "openai_responses"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_cost_microunits",
        "require_cost_known",
        "pricing_contract"
      ],
      "properties": {
        "max_total_cost_microunits": {"type": "integer", "minimum": 1},
        "require_cost_known": {"const": true},
        "pricing_contract": {"const": "deepseek_v4_2026_08_17"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "repetitions",
          "command",
          "expected_text_sha256",
          "min_confidence_lower_basis_points",
          "max_p95_latency_ms",
          "max_cost_microunits",
          "max_event_shape_variants"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "mode": {"enum": ["single", "multi_agent"]},
          "repetitions": {"type": "integer", "minimum": 1},
          "command": {"$ref": "#/$defs/strings"},
          "expected_text_sha256": {"$ref": "#/$defs/digest"},
          "min_confidence_lower_basis_points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "max_p95_latency_ms": {"type": "integer", "minimum": 1},
          "max_cost_microunits": {"type": "integer", "minimum": 1},
          "max_event_shape_variants": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
