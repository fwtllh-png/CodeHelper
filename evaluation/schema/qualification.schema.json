{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper Foundation Qualification Epoch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "foundation_digest",
    "source_digest",
    "runtime_digest",
    "vsix_digest",
    "lock_identity",
    "status",
    "started_at",
    "ended_at",
    "scheduled",
    "settled",
    "passed",
    "failed",
    "unavailable",
    "not_evaluated",
    "invalid",
    "results",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": ["foundation_epoch", "integration", "discovery", "chaos", "live"]
    },
    "foundation_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_digest": {
      "$ref": "#/$defs/digest"
    },
    "vsix_digest": {
      "$ref": "#/$defs/digest"
    },
    "lock_identity": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": ["passed", "failed", "unavailable", "not_evaluated", "invalid"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled": {
      "$ref": "#/$defs/nonnegative"
    },
    "settled": {
      "$ref": "#/$defs/nonnegative"
    },
    "passed": {
      "$ref": "#/$defs/nonnegative"
    },
    "failed": {
      "$ref": "#/$defs/nonnegative"
    },
    "unavailable": {
      "$ref": "#/$defs/nonnegative"
    },
    "not_evaluated": {
      "$ref": "#/$defs/nonnegative"
    },
    "invalid": {
      "$ref": "#/$defs/nonnegative"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_digest",
          "depends_on",
          "duration_ms",
          "reason_code",
          "cleanup_required",
          "cleanup_evidence_digest",
          "owned_resources",
          "cleanup_outstanding"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": ["passed", "failed", "unavailable", "not_evaluated", "invalid"]
          },
          "evidence_digest": {
            "$ref": "#/$defs/digest"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "duration_ms": {
            "$ref": "#/$defs/nonnegative"
          },
          "reason_code": {
            "$ref": "#/$defs/id"
          },
          "cleanup_required": {
            "type": "boolean"
          },
          "cleanup_evidence_digest": {
            "$ref": "#/$defs/digest"
          },
          "owned_resources": {
            "$ref": "#/$defs/nonnegative"
          },
          "cleanup_outstanding": {
            "$ref": "#/$defs/nonnegative"
          }
        }
      }
    },
    "evidence_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    }
  }
}
