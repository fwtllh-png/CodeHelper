{
  "protocol": "openai_chat",
  "path": "/chat/completions",
  "model": "fixture-model",
  "streams": [
    "explain.sse",
    "edit.sse",
    "refactor.sse",
    "tests.sse",
    "diagnostic-explain.sse",
    "diagnostic-fix.sse",
    "changes-call.sse",
    "changes-complete.sse",
    "changes-deny-call.sse",
    "changes-deny-complete.sse"
