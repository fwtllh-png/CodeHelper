{
  "name": "edit-transaction-move",
  "category": "edit_transaction",
  "note": "A rename with no git and no strong sandbox. It pins that a move is observed as two changes — the source deleted and the destination created — so a turn that only renames files is still visible to the receipt and to the verification gate.",
  "prompt": "rename old_name.py to new_name.py",
  "tools": true,
  "max_steps": 6,
  "timeout_ms": 60000,
  "verify": {
    "mode": "hard",
    "scope": "repository",
    "on_failure": "fail",
    "command": "test -f new_name.py && test ! -e old_name.py",
    "max_repair_steps": 0
  },
  "expect": {
    "terminal": "completed",
    "files": {
      "new_name.py": "VALUE = 1\n"
    },
    "absent": ["old_name.py"],
    "tools_used": ["file_read", "file_apply"],
    "receipt_changes": ["new_name.py", "old_name.py"],
    "verify_status": "passed",
    "verify_action": "passed",
    "output_contains": ["renamed"]
  }
}
