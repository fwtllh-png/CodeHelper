{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper production evaluation release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_digest",
    "harness_digest",
    "runtime_digest",
    "host_digest",
    "provider_digest",
    "model_digest",
    "config_digest",
    "required_lanes",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "harness_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_digest": {
      "$ref": "#/$defs/digest"
    },
    "host_digest": {
      "$ref": "#/$defs/digest"
    },
    "provider_digest": {
      "$ref": "#/$defs/digest"
    },
    "model_digest": {
      "$ref": "#/$defs/digest"
    },
    "config_digest": {
      "$ref": "#/$defs/digest"
    },
    "required_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_digest"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "const": "passed"
          },
          "evidence_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "decision": {
      "enum": ["admit", "deny"]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
