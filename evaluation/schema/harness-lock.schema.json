{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper production evaluation Harness Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "source_commit",
    "source_digest",
    "foundation_digest",
    "harness_digest",
    "evaluation_digest",
    "runtime_digest",
    "vsix_digest",
    "host_digest",
    "toolchain_digest",
    "production_scan_digest",
    "lock_identity",
    "input_roots",
    "inputs",
    "clean_integration_runs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["candidate", "frozen_qualified"]
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "harness_digest": {
      "$ref": "#/$defs/digest"
    },
    "foundation_digest": {
      "$ref": "#/$defs/digest"
    },
    "evaluation_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_digest": {
      "$ref": "#/$defs/digest"
    },
    "host_digest": {
      "$ref": "#/$defs/digest"
    },
    "vsix_digest": {
      "$ref": "#/$defs/digest"
    },
    "toolchain_digest": {
      "$ref": "#/$defs/digest"
    },
    "production_scan_digest": {
      "$ref": "#/$defs/digest"
    },
    "lock_identity": {
      "$ref": "#/$defs/digest"
    },
    "input_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "clean_integration_runs": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
