{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper D2 campaign plan and coverage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "cases",
    "coverage",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"$ref": "#/$defs/id"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family_id", "seed", "values"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "family_id": {"$ref": "#/$defs/id"},
          "seed": {"type": "integer", "minimum": 1},
          "values": {
            "type": "object",
            "minProperties": 2,
            "propertyNames": {"$ref": "#/$defs/id"},
            "additionalProperties": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "pairwise_total",
        "pairwise_covered",
        "required_combination_total",
        "required_combination_covered",
        "boundary_total",
        "boundary_covered",
        "fault_trigger_total",
        "fault_trigger_covered"
      ],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "selected", "unselected"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "selected": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              },
              "unselected": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              }
            }
          }
        },
        "pairwise_total": {"$ref": "#/$defs/nonnegative"},
        "pairwise_covered": {"$ref": "#/$defs/nonnegative"},
        "required_combination_total": {"$ref": "#/$defs/nonnegative"},
        "required_combination_covered": {"$ref": "#/$defs/nonnegative"},
        "boundary_total": {"$ref": "#/$defs/nonnegative"},
        "boundary_covered": {"$ref": "#/$defs/nonnegative"},
        "fault_trigger_total": {"$ref": "#/$defs/nonnegative"},
        "fault_trigger_covered": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "evidence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    }
  }
}
