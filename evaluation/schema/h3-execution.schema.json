{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper H3 Endurance and Release Execution Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "endurance", "release"],
  "properties": {
    "schema_version": {"const": 1},
    "endurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "turn_interval_seconds",
        "turn_timeout_seconds",
        "warmup_turns",
        "min_completed_turns",
        "prompt",
        "max_rss_slope_bytes_per_turn",
        "max_rss_growth_bytes",
        "max_fd_slope_milli_per_turn",
        "max_fd_growth",
        "max_persistence_slope_bytes_per_turn",
        "max_latency_slope_milli_ms_per_turn",
        "max_p95_latency_ms",
        "max_late_early_latency_ratio_basis_points"
      ],
      "properties": {
        "duration_seconds": {"type": "integer", "minimum": 14400},
        "turn_interval_seconds": {"type": "integer", "minimum": 1},
        "turn_timeout_seconds": {"type": "integer", "minimum": 1},
        "warmup_turns": {"type": "integer", "minimum": 1},
        "min_completed_turns": {"type": "integer", "minimum": 1},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 256},
        "max_rss_slope_bytes_per_turn": {"type": "integer", "minimum": 0},
        "max_rss_growth_bytes": {"type": "integer", "minimum": 0},
        "max_fd_slope_milli_per_turn": {"type": "integer", "minimum": 0},
        "max_fd_growth": {"type": "integer", "minimum": 0},
        "max_persistence_slope_bytes_per_turn": {"type": "integer", "minimum": 1},
        "max_latency_slope_milli_ms_per_turn": {"type": "integer", "minimum": 0},
        "max_p95_latency_ms": {"type": "integer", "minimum": 1},
        "max_late_early_latency_ratio_basis_points": {
          "type": "integer",
          "minimum": 10000
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_lanes",
        "release_command",
        "vscode_rc_command",
        "package_command",
        "package_targets"
      ],
      "properties": {
        "required_lanes": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "release_command": {"$ref": "#/$defs/strings"},
        "vscode_rc_command": {"$ref": "#/$defs/strings"},
        "package_command": {"$ref": "#/$defs/strings"},
        "package_targets": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
