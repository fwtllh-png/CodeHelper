{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper D2 Discovery Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "base_lock_identity",
    "base_foundation_digest",
    "source_digest",
    "evaluation_digest",
    "runtime_digest",
    "host_digest",
    "vsix_digest",
    "campaign_digest",
    "planner_digest",
    "discovery_digest",
    "lock_identity",
    "discovery_input_roots",
    "inputs",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["candidate", "qualified"]},
    "base_lock_identity": {"$ref": "#/$defs/digest"},
    "base_foundation_digest": {"$ref": "#/$defs/digest"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "evaluation_digest": {"$ref": "#/$defs/digest"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "host_digest": {"$ref": "#/$defs/digest"},
    "vsix_digest": {"$ref": "#/$defs/digest"},
    "campaign_digest": {"$ref": "#/$defs/digest"},
    "planner_digest": {"$ref": "#/$defs/digest"},
    "discovery_digest": {"$ref": "#/$defs/digest"},
    "lock_identity": {"$ref": "#/$defs/digest"},
    "discovery_input_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "qualification_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "qualified"}}},
      "then": {"required": ["qualification_digest"]},
      "else": {"not": {"required": ["qualification_digest"]}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
