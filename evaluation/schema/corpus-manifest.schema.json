{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper replay corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_format",
    "source_class",
    "source_digest",
    "selector",
    "source_event_count",
    "event_count",
    "trace_digest",
    "first_digest",
    "last_digest",
    "failure_signature",
    "content_mode",
    "secret_scan"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "source_format": {
      "enum": [
        "vscode_runtime_capture_v1",
        "provider_stream_v1",
        "observation_journal_v1"
      ]
    },
    "source_class": {
      "enum": [
        "real_private_capture",
        "synthetic_fixture"
      ]
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "full",
            "operation",
            "orphan_request"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_event_count": {
      "type": "integer",
      "minimum": 1
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "trace_digest": {
      "$ref": "#/$defs/digest"
    },
    "first_digest": {
      "$ref": "#/$defs/digest"
    },
    "last_digest": {
      "$ref": "#/$defs/digest"
    },
    "failure_signature": {
      "enum": [
        "turn_failed",
        "turn_cancelled",
        "turn_completed",
        "acp_request_failed",
        "acp_request_incomplete",
        "partial_trace",
        "transport_interrupted"
      ]
    },
    "content_mode": {
      "const": "metadata_only"
    },
    "secret_scan": {
      "const": "passed"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
