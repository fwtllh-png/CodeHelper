{
  "version": 1,
  "scope": [
    "tui",
    "vscode"
  ],
  "principles": [
    "show state before decoration",
    "keep the primary action keyboard reachable",
    "bind consequential actions to exact Runtime identities",
    "never encode meaning with color alone",
    "preserve user context across loading, failure, and recovery"
  ],
  "information_architecture": [
    {
      "region": "context",
      "purpose": "workspace, session, mode, trust, and Runtime identity",
      "priority": 1
    },
    {
      "region": "transcript",
      "purpose": "user requests, reasoning disclosure, output, tools, and receipts",
      "priority": 2
    },
    {
      "region": "action",
      "purpose": "composer, approval, input, stop, retry, setup, and repair",
      "priority": 1
    },
    {
      "region": "detail",
      "purpose": "plans, changes, tasks, agents, jobs, usage, and diagnostics",
      "priority": 3
    }
  ],
  "tokens": {
    "spacing": {
      "inline": 1,
      "control": 2,
      "section": 3,
      "panel": 4
    },
    "semantic_color": {
      "neutral": {
        "meaning": "secondary or inactive information",
        "tui": "Dim",
        "vscode": "descriptionForeground"
      },
      "info": {
        "meaning": "active work or non-blocking information",
        "tui": "Info",
        "vscode": "textLink.foreground"
      },
      "success": {
        "meaning": "verified or terminal success",
        "tui": "Success",
        "vscode": "testing.iconPassed"
      },
      "warning": {
        "meaning": "degraded capability or decision required",
        "tui": "Warn",
        "vscode": "notificationsWarningIcon.foreground"
      },
      "danger": {
        "meaning": "failure, denial, destructive effect, or blocked state",
        "tui": "Danger",
        "vscode": "errorForeground"
      },
      "focus": {
        "meaning": "keyboard focus or current selection",
        "tui": "Brand",
        "vscode": "focusBorder"
      }
    },
    "typography": {
      "title": "one level above body, bold",
      "section": "body size, semibold",
      "body": "host default",
      "metadata": "host default, secondary foreground",
      "code": "host monospace"
    },
    "icon_rule": "use a host-native icon plus a text label; glyph-only controls require an accessible name"
  },
  "states": [
    {
      "id": "idle",
      "terminal": false,
      "requires_action": false,
      "tui_aliases": [
        "idle"
      ],
      "vscode_aliases": [
        "stopped"
      ]
    },
    {
      "id": "working",
      "terminal": false,
      "requires_action": false,
      "tui_aliases": [
        "typing",
        "working",
        "streaming",
        "running"
      ],
      "vscode_aliases": [
        "starting",
        "recovering",
        "running"
      ]
    },
    {
      "id": "waiting",
      "terminal": false,
      "requires_action": true,
      "tui_aliases": [
        "waiting",
        "pending",
        "approval"
      ],
      "vscode_aliases": [
        "pending",
        "approval_required",
        "input_required"
      ]
    },
    {
      "id": "succeeded",
      "terminal": true,
      "requires_action": false,
      "tui_aliases": [
        "done",
        "completed",
        "ready"
      ],
      "vscode_aliases": [
        "completed",
        "ready",
        "approve"
      ]
    },
    {
      "id": "degraded",
      "terminal": false,
      "requires_action": false,
      "tui_aliases": [
        "degraded"
      ],
      "vscode_aliases": [
        "degraded"
      ]
    },
    {
      "id": "failed",
      "terminal": true,
      "requires_action": true,
      "tui_aliases": [
        "failed",
        "rejected",
        "canceled"
      ],
      "vscode_aliases": [
        "failed",
        "deny",
        "cancel"
      ]
    },
    {
      "id": "blocked",
      "terminal": false,
      "requires_action": true,
      "tui_aliases": [
        "blocked"
      ],
      "vscode_aliases": [
        "blocked",
        "untrusted"
      ]
    }
  ],
  "lifecycle_feedback": [
    {
      "id": "setup",
      "canonical": "blocked",
      "next_action": "trust the workspace or run Setup"
    },
    {
      "id": "empty",
      "canonical": "idle",
      "next_action": "enter a task"
    },
    {
      "id": "loading",
      "canonical": "working",
      "next_action": "wait or stop"
    },
    {
      "id": "streaming",
      "canonical": "working",
      "next_action": "follow progress or stop"
    },
    {
      "id": "approval",
      "canonical": "waiting",
      "next_action": "review target and approve, deny, or cancel"
    },
    {
      "id": "verify",
      "canonical": "working",
      "next_action": "review checks and verdict"
    },
    {
      "id": "failure",
      "canonical": "failed",
      "next_action": "inspect reason and repair or retry"
    },
    {
      "id": "recovery",
      "canonical": "working",
      "next_action": "wait for Chat and cursor restoration"
    },
    {
      "id": "completed",
      "canonical": "succeeded",
      "next_action": "review changes and Receipt"
    }
  ],
  "terminology": [
    {
      "preferred": "Runtime",
      "avoid": [
        "backend",
        "server"
      ]
    },
    {
      "preferred": "Chat",
      "avoid": [
        "conversation"
      ]
    },
    {
      "preferred": "Turn",
      "avoid": [
        "request cycle"
      ]
    },
    {
      "preferred": "Edit Plan",
      "avoid": [
        "patch proposal"
      ]
    },
    {
      "preferred": "Credential Reference",
      "avoid": [
        "API key value",
        "secret field"
      ]
    },
    {
      "preferred": "Receipt",
      "avoid": [
        "success message"
      ]
    }
  ],
  "consequential_actions": [
    {
      "level": "review",
      "examples": [
        "read context",
        "open diff",
        "copy repair action"
      ],
      "rule": "show scope and result; confirmation is not required"
    },
    {
      "level": "approve",
      "examples": [
        "apply an Edit Plan",
        "execute a guarded command",
        "send context to a provider"
      ],
      "rule": "show target, effect, exact Runtime identity, and explicit approve/deny actions"
    },
    {
      "level": "destructive",
      "examples": [
        "delete",
        "force replace configuration",
        "discard or revert changes"
      ],
      "rule": "use a danger treatment, state irreversibility, and require explicit confirmation"
    }
  ],
  "motion": {
    "full": "motion may indicate ongoing work but cannot be the only state signal",
    "reduced": "replace shimmer and repeated animation with a static state change",
    "still": "all information and actions remain available without animation"
  },
  "responsive": {
    "compact": "preserve context, current state, primary action, and failure recovery; collapse detail first",
    "regular": "show transcript and current action together",
    "wide": "detail may appear beside the transcript without moving the primary action"
  },
  "accessibility": [
    "all actions are reachable by keyboard",
    "focus order follows context, transcript, current action, then detail",
    "status changes expose text and an appropriate live-region or host notification",
    "controls have stable accessible names",
    "light, dark, and high-contrast themes use host tokens",
    "reduced-motion and no-color modes preserve meaning"
  ],
  "review_checklist": [
    "UX-IA-01",
    "UX-STATE-01",
    "UX-COLOR-01",
    "UX-KEYBOARD-01",
    "UX-FOCUS-01",
    "UX-DANGER-01",
    "UX-MOTION-01",
    "UX-EMPTY-01",
    "UX-LOADING-01",
    "UX-FAILURE-01",
    "UX-RECEIPT-01"
  ]
}
