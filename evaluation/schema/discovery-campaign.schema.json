{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper D2 discovery campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "selection_strategy",
    "adaptive",
    "production_entry_points",
    "axes",
    "families",
    "seeds",
    "budgets",
    "cleanup",
    "privacy",
    "stop_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "selection_strategy": {"const": "pairwise"},
    "adaptive": {"type": "boolean"},
    "adaptive_policy": {"$ref": "#/$defs/id"},
    "production_entry_points": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["cli", "acp", "vscode"]}
    },
    "axes": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "values": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "boundary", "fault_trigger"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "boundary": {"type": "boolean"},
                "fault_trigger": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "axes", "required_combinations"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "axes": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "required_combinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["values"],
              "properties": {
                "values": {
                  "type": "object",
                  "minProperties": 2,
                  "propertyNames": {"$ref": "#/$defs/id"},
                  "additionalProperties": {"$ref": "#/$defs/id"}
                }
              }
            }
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runs",
        "wall_time_ms",
        "max_model_cost_microunits",
        "max_parallelism"
      ],
      "properties": {
        "max_runs": {"type": "integer", "minimum": 7, "maximum": 10000},
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "max_model_cost_microunits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "resources", "timeout_ms"],
      "properties": {
        "owner": {"$ref": "#/$defs/id"},
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_retention_hours",
        "persist_user_content",
        "promotion_review_required"
      ],
      "properties": {
        "capture_retention_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "persist_user_content": {"const": false},
        "promotion_review_required": {"const": true}
      }
    },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_invalid",
        "max_cleanup_outstanding",
        "stop_on_identity_drift",
        "stop_on_systemic_pattern"
      ],
      "properties": {
        "max_invalid": {"const": 0},
        "max_cleanup_outstanding": {"const": 0},
        "stop_on_identity_drift": {"const": true},
        "stop_on_systemic_pattern": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"adaptive": {"const": true}}},
      "then": {"required": ["adaptive_policy"]},
      "else": {"not": {"required": ["adaptive_policy"]}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    }
  }
}
