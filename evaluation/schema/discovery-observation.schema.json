{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper D2 discovery observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "campaign_id",
    "case_id",
    "discovery_lock_identity",
    "environment_digest",
    "producer",
    "classification",
    "severity",
    "reproducibility",
    "attempts",
    "evidence_digests",
    "first_observed_at",
    "summary_code",
    "contains_private_content"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"},
    "discovery_lock_identity": {"$ref": "#/$defs/digest"},
    "environment_digest": {"$ref": "#/$defs/digest"},
    "producer": {"$ref": "#/$defs/id"},
    "classification": {
      "enum": [
        "product_candidate",
        "harness_incident",
        "environment_failure",
        "expected_variance",
        "unattributed"
      ]
    },
    "severity": {"enum": ["p0", "p1", "p2", "p3"]},
    "reproducibility": {
      "enum": [
        "exact_seed",
        "controlled_matrix",
        "live_statistical",
        "unreproduced"
      ]
    },
    "attempts": {"type": "integer", "minimum": 1},
    "evidence_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "first_observed_at": {"type": "string", "format": "date-time"},
    "summary_code": {"$ref": "#/$defs/id"},
    "contains_private_content": {"const": false}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
