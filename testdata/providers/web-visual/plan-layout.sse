data: {"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_visual_plan_layout","function":{"name":"submit_plan","arguments":"{\"version\":1,\"title\":\"Stabilize prompt cache prefixes\",\"objective\":\"Implement deterministic prompt assembly and expose cache efficiency without changing tool causality or runtime safety boundaries.\",\"steps\":[{\"id\":\"sort\",\"title\":\"Sort tool definitions deterministically\",\"status\":\"pending\",\"expected_evidence\":\"Equivalent tool sets produce the same serialized order\"},{\"id\":\"contract\",\"title\":\"Add prefix stability contract tests\",\"status\":\"pending\",\"expected_evidence\":\"Repeated snapshots produce identical message and definition bytes\"},{\"id\":\"revision\",\"title\":\"Verify cache revision boundaries\",\"status\":\"pending\",\"expected_evidence\":\"Unrelated profile updates preserve the prompt cache revision\"},{\"id\":\"metrics\",\"title\":\"Expose cache hit and miss metrics\",\"status\":\"pending\",\"expected_evidence\":\"Turn receipts report cache efficiency with TTFT\"},{\"id\":\"verify\",\"title\":\"Run focused and repository checks\",\"status\":\"pending\",\"expected_evidence\":\"Affected tests, ratchet, and diff checks pass\"}]}"}}]},"finish_reason":"tool_calls"}]}
