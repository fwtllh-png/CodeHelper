{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper Mutation contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mutations"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mutations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "replay_level",
          "minimum_executions",
          "expected_observation"
        ],
        "properties": {
          "id": {
            "enum": [
              "split",
              "delay",
              "duplicate",
              "truncate",
              "interrupt",
              "unknown_event",
              "malformed_event"
            ]
          },
          "replay_level": {
            "enum": ["provider", "runtime", "host"]
          },
          "minimum_executions": {
            "type": "integer",
            "minimum": 1
          },
          "expected_observation": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
          }
        }
      }
    }
  }
}
