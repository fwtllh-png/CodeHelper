{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper Oracle contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracles"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "oracles": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence",
          "producers",
          "absence_status",
          "proved_zero",
          "negative_control"
        ],
        "properties": {
          "id": {
            "enum": [
              "runtime",
              "side_effect",
              "workspace",
              "verification",
              "persistence",
              "host",
              "security",
              "resource",
              "task_quality"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/id_list"
          },
          "producers": {
            "$ref": "#/$defs/id_list"
          },
          "absence_status": {
            "const": "invalid"
          },
          "proved_zero": {
            "type": "boolean"
          },
          "negative_control": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "id_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  }
}
