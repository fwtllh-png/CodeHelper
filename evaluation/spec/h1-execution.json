{
  "schema_version": 1,
  "cases": [
    {
      "id": "official-vscode-electron",
      "lane": "extension_host",
      "kind": "electron",
      "command": ["npm", "--prefix", "extensions/vscode", "run", "test:electron"]
    },
    {
      "id": "vscode-runtime-restart",
      "lane": "extension_host",
      "kind": "vscode_runtime",
      "command": ["npm", "--prefix", "extensions/vscode", "test"]
    },
    {
      "id": "process-session-cancel",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/platform/process", "-run", "^TestSessionCancellationKillsProcessGroup$"]
    },
    {
      "id": "process-hook-timeout",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/adapter/hooks", "-run", "^TestTimeoutKillsProcessTree$"]
    },
    {
      "id": "process-mcp-forced-kill",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/adapter/mcp", "-run", "^TestStdioForcedKillCleansProcessGroup$"]
    },
    {
      "id": "process-runtime-prestart-cancel",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/runtime/app", "-run", "^TestCancelBeforeCoordinatorStartupCommitsCanceledTurn$"]
    },
    {
      "id": "process-child-idle-lease",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/runtime/app/wire", "-run", "^TestChildAgentIdleLeaseInterruptsTurnRecoverably$"]
    },
    {
      "id": "process-pty-cancel",
      "lane": "process",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/platform/process", "-run", "^TestRunPTYAndCancellation$"]
    },
    {
      "id": "provider-sse-disconnect",
      "lane": "provider",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/adapter/provider", "-run", "^TestFaultInjectionSSEDisconnect$"]
    },
    {
      "id": "provider-boundary-disconnect",
      "lane": "provider",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/adapter/provider/assembly", "-run", "^TestResponseAssemblyDisconnectAtEveryBoundaryRetainsConfirmedData$"]
    },
    {
      "id": "provider-idle-timeout",
      "lane": "provider",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/adapter/provider/httpclient", "-run", "^TestClientStreamIdleTimeoutAndNonIdempotentRetry$"]
    },
    {
      "id": "provider-managed-proxy",
      "lane": "provider",
      "kind": "go_test",
      "command": ["go", "test", "-tags=capability", "-race", "-count=1", "./internal/platform/process", "-run", "^TestRealManagedProxyBlocksDirectEgress$"],
      "environment": ["CODEHELPER_SANDBOX_STAGE=1"]
    },
    {
      "id": "persistence-eventlog-kill",
      "lane": "persistence",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/persist/state/eventlog", "-run", "^TestFaultInjectionKillMidWriteRepairsTornTail$"]
    },
    {
      "id": "persistence-terminal-crash-matrix",
      "lane": "persistence",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/persist/state/turnstate", "-run", "^TestR5TerminalCommitCrashPointMatrixIsAtomicAndIdempotent$"]
    },
    {
      "id": "persistence-journal-recovery",
      "lane": "persistence",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/persist/workspacejournal", "-run", "^TestTheNextProcessUndoesATurnAKilledProcessLeftHalfApplied$"]
    },
    {
      "id": "filesystem-symlink-swap",
      "lane": "filesystem",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/security/sandbox", "-run", "^TestDescriptorRelativeIOResistsConcurrentSymlinkSwap$"]
    },
    {
      "id": "filesystem-link-escape",
      "lane": "filesystem",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/security/sandbox", "-run", "^TestValidateWorkspaceLinksRejectsLinkOutsideWorkspace$"]
    },
    {
      "id": "filesystem-rollback-external-edit",
      "lane": "filesystem",
      "kind": "go_test",
      "command": ["go", "test", "-race", "-count=1", "./internal/persist/workspacejournal", "-run", "^TestJournalRollbackNeverClobbersAnExternalEdit$"]
    }
  ]
}
