{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper corpus promotion review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "batch_id",
    "reviewer",
    "decision",
    "source_digest",
    "reviewed_on"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "batch_id": {
      "$ref": "#/$defs/id"
    },
    "reviewer": {
      "$ref": "#/$defs/id"
    },
    "decision": {
      "const": "approved"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
