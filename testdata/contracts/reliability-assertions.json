{
  "version": 1,
  "description": "Per-test assertion requirements for the reliability matrix. Each entry maps a (boundary, case) pair to the assertions that the test must contain. The static verifier (verify-reliability-assertions.go) checks that each test function actually contains these assertion patterns.",
  "assertions": [
    {
      "boundary": "provider",
      "case": "retryable_failure",
      "test": "TestClientMakesOneAttemptForRetryableHTTPStatusMatrix",
      "package": "./internal/adapter/provider/httpclient",
      "required": [
        {"type": "fault_check", "note": "must verify the error is a typed failure"},
        {"type": "retryable_check", "note": "must verify the error is retryable"}
      ]
    },
    {
      "boundary": "provider",
      "case": "permanent_failure",
      "test": "TestClientDoesNotRetryPermanentClientError",
      "package": "./internal/adapter/provider/httpclient",
      "required": [
        {"type": "fault_check", "note": "must verify the error is a typed failure"},
        {"type": "single_attempt_check", "note": "must verify only one attempt was made"}
      ]
    },
    {
      "boundary": "provider",
      "case": "cancellation",
      "test": "TestClientCancellationClosesResponse",
      "package": "./internal/adapter/provider/httpclient",
      "required": [
        {"type": "context_canceled_check", "note": "must verify context cancellation is handled"},
        {"type": "resource_cleanup_check", "note": "must verify the response body is closed"}
      ]
    },
    {
      "boundary": "tool",
      "case": "cancellation",
      "test": "TestFaultInjectionToolCancelReleasesClaim",
      "package": "./internal/adapter/tool",
      "required": [
        {"type": "context_canceled_check", "note": "must verify context cancellation releases the claim"},
        {"type": "resource_release_check", "note": "must verify the resource claim is released"}
      ]
    },
    {
      "boundary": "tool",
      "case": "permanent_failure",
      "test": "TestEgressDeniedApprovalDenyKeepsFailure",
      "package": "./internal/adapter/tool/guard",
      "required": [
        {"type": "no_recovery_check", "note": "must verify the failure is not retried (executor.calls == 1)"}
      ]
    },
    {
      "boundary": "journal",
      "case": "crash_recovery",
      "test": "TestFaultInjectionKillMidWriteRepairsTornTail",
      "package": "./internal/persist/state/eventlog",
      "required": [
        {"type": "recovery_check", "note": "must verify the torn tail is repaired (LastSequence == 1)"}
      ]
    },
    {
      "boundary": "host",
      "case": "crash_recovery",
      "test": "TestBinaryInteropFramingConcurrencyAndShutdown",
      "package": "./internal/host/runtimeapi/acp",
      "required": [
        {"type": "concurrency_check", "note": "must verify concurrent framing is safe (verified by structural concurrent writes)"}
      ]
    }
  ]
}