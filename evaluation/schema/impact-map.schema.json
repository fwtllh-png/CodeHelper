{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper evaluation changed-path impact map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fallback",
    "exclusions",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "fallback": {
      "const": "all_p0"
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
            }
          }
        }
      }
    }
  }
}
