{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper D1 Execution Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios", "hosts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "command", "proves"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "host": {"$ref": "#/$defs/id"},
          "command": {"$ref": "#/$defs/command"},
          "minimum_tests": {
            "type": "integer",
            "minimum": 1
          },
          "proves": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "command"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "host": {"$ref": "#/$defs/id"},
          "command": {"$ref": "#/$defs/command"},
          "minimum_tests": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
