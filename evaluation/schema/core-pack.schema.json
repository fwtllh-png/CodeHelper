{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeHelper core evaluation scenario pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_families",
    "mandatory_oracles",
    "scenarios",
    "fault_cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "minimum_families": {
      "type": "integer",
      "minimum": 30
    },
    "mandatory_oracles": {
      "$ref": "#/$defs/oracle_list"
    },
    "scenarios": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "fault_cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/fault_case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "risk": {
      "enum": ["P0", "P1", "P2"]
    },
    "oracle": {
      "enum": [
        "runtime",
        "side_effect",
        "workspace",
        "verification",
        "persistence",
        "host",
        "security",
        "resource",
        "task_quality"
      ]
    },
    "oracle_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/oracle"
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "family",
        "risk",
        "owner",
        "fixture_id",
        "fixture_profile",
        "expected_facts",
        "required_oracles",
        "required_mutations",
        "impact_tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "$ref": "#/$defs/id"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "fixture_profile": {
          "enum": [
            "terminal",
            "parked",
            "effect-zero",
            "workspace-readonly",
            "verification",
            "persistence",
            "host",
            "security",
            "resource",
            "task-quality"
          ]
        },
        "expected_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "required_oracles": {
          "$ref": "#/$defs/oracle_list"
        },
        "required_mutations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "split",
              "delay",
              "duplicate",
              "truncate",
              "interrupt",
              "unknown_event",
              "malformed_event"
            ]
          }
        },
        "impact_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "fault_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "risk",
        "expected_status",
        "expected_signature",
        "expected_domain"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fault": {
          "enum": [
            "duplicate_effect",
            "double_terminal",
            "stuck_running",
            "receipt_drift",
            "replay_drift",
            "guard_bypass",
            "security_bypass",
            "workspace_scope_violation",
            "verification_failure",
            "resource_leak",
            "host_projection_drift",
            "task_quality_failure",
            "malformed_evidence"
          ]
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "expected_status": {
          "enum": ["failed", "invalid"]
        },
        "expected_signature": {
          "type": "string",
          "pattern": "^[a-z_]+:[a-z_]+$"
        },
        "expected_domain": {
          "enum": [
            "runtime_state",
            "tool_or_guard",
            "persistence_or_recovery",
            "host_projection",
            "platform_environment",
            "task_quality",
            "evaluation_harness"
          ]
        }
      }
    }
  }
}
